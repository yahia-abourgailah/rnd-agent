# Copy to .env and fill in real values. Never commit the real .env.
#
# One file per host, always named `.env` at the repo root. Docker Compose reads
# it automatically — both for the ${VAR} substitutions in docker-compose.yml and
# as the api container's environment — and refuses to start without it.

# --- Database ---
DATABASE_URL=postgresql+psycopg://launch_intel:launch_intel@localhost:5432/launch_intel
# Least-privilege role for LLM-authored SQL (chatbot_agent). MUST be a
# GRANT SELECT-only user in production. Blank = reuse DATABASE_URL.
DATABASE_READONLY_URL=postgresql+psycopg://launch_intel_ro:CHANGEME@localhost:5432/launch_intel

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- LLM extraction (Instructor) ---
OPENAI_API_KEY=sk-...
EXTRACTION_MODEL=openai/gpt-4o-mini
# Set when using a self-hosted / company-gateway model that speaks the OpenAI
# API (keep the "openai/" prefix on EXTRACTION_MODEL). Leave blank for OpenAI.
LLM_BASE_URL=
# Context window, only needed for models ScrapeGraphAI does not recognise.
LLM_MODEL_TOKENS=

# --- Slack notifications (TODO: phase 3) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_ALERT_CHANNEL=#launch-alerts

# --- API auth ---
# Shared secret the CRM backend sends as the `X-API-Key` header to call the
# insights API. Generate a strong random value (e.g. `python -c "import secrets;
# print(secrets.token_urlsafe(32))"`). Empty disables auth (local dev only).
API_KEY=

# --- Crawling ---
# Neutral crawler identity; set a reachable contact address per the team's
# legal decision on crawling. Does not name the operating company.
USER_AGENT=MarketIntelBot/1.0 (+mailto:research-bot@example.com)
PLAYWRIGHT_HEADLESS=true
DEFAULT_REQUEST_TIMEOUT_SECONDS=30
DEFAULT_RATE_LIMIT_PER_HOST_SECONDS=2

# --- App ---
ENV=development
LOG_LEVEL=INFO

# --- Host ports published by docker-compose.override.yml (local dev only) ---
# Change these when another project on the machine already owns the default.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000

# --- Chatbot agent (LangGraph SQL agent) ---
# Self-hosted model behind the OpenAI-compatible endpoint in LLM_BASE_URL.
# No "openai/" prefix here — the provider is passed separately.
CHATBOT_MODEL=gemma-4
CHATBOT_SQL_TIMEOUT_SECONDS=15
CHATBOT_SQL_MAX_ROWS=100
