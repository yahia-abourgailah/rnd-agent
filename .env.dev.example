# Copy to .env.dev and fill in. Load it with: ENV_FILE=.env.dev
# Local development on your own machine against the docker-compose services.

ENV=development
LOG_LEVEL=DEBUG

# --- Database (local docker-compose postgres) ---
DATABASE_URL=postgresql+psycopg://launch_intel:launch_intel@localhost:5432/launch_intel
# Least-privilege role for LLM-authored SQL (chatbot_agent). MUST be a
# GRANT SELECT-only user in production. Blank = reuse DATABASE_URL.
DATABASE_READONLY_URL=

# --- Redis / Celery (local docker-compose redis) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- LLM extraction (cheap model while iterating) ---
OPENAI_API_KEY=sk-...
EXTRACTION_MODEL=openai/gpt-4o-mini
# Set when using a self-hosted / company-gateway model that speaks the OpenAI
# API (keep the "openai/" prefix on EXTRACTION_MODEL). Leave blank for OpenAI.
LLM_BASE_URL=
# Context window, only needed for models ScrapeGraphAI does not recognise.
LLM_MODEL_TOKENS=

# --- Slack (dev channel only — never the real one; notify is Phase 3) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_ALERT_CHANNEL=#launch-alerts-dev

# --- Crawling (gentle: watch a demo source, slow rate) ---
# Neutral crawler identity; set a reachable contact address per the team's
# legal decision on crawling. Does not name the operating company.
USER_AGENT=MarketIntelBot/1.0 (+mailto:research-bot@example.com)
PLAYWRIGHT_HEADLESS=true
DEFAULT_REQUEST_TIMEOUT_SECONDS=30
DEFAULT_RATE_LIMIT_PER_HOST_SECONDS=2

# --- Chatbot agent (LangGraph SQL agent) ---
# Self-hosted model behind the OpenAI-compatible endpoint in LLM_BASE_URL.
# No "openai/" prefix here — the provider is passed separately.
CHATBOT_MODEL=gemma-4
CHATBOT_SQL_TIMEOUT_SECONDS=15
CHATBOT_SQL_MAX_ROWS=100
